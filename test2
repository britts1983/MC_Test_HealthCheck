pipeline {
    agent {
        label "built-in"
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES')
        sendSplunkConsoleLog()
        disableConcurrentBuilds()
    }

    stages {
        stage("checkout") {
            options {
                timeout(time: 5, unit: 'MINUTES')
            }
            steps {
                script {
                    if (checkGitavailability() == '200') {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: '*/main']],
                            userRemoteConfigs: [
                                [
                                    url: 'https://github.axa.com/aljdevops/monitoring-jenkins.git',
                                    credentialsId: 'ALJ_OPS_GITHUB_MACHINE_USER'
                                ]
                            ]
                        ])
                    }
                }
            }
        }
        stage('Build') {
            options {
                timeout(time: 20, unit: 'MINUTES')
            }
            steps {
                script {
                    echo "params.login: ${params.login}"
                    echo "params.login2: ${params.login2}"
                    withCredentials([
                        usernamePassword(credentialsId: params.login, usernameVariable: 'CRED_USR', passwordVariable: 'CRED_PSW'),
                        usernamePassword(credentialsId: params.login2, usernameVariable: 'CRED2_USR', passwordVariable: 'CRED2_PSW'),
                        string(credentialsId: "MPI-TOD-Token", variable: 'TOKEN'),
                        string(credentialsId: "TOD-API-Token", variable: 'API_TOKEN')
                    ]) {
                        def baseCmd = '--yaml-file=$WORKSPACE/group_jobs/realtime/ --userid=${CRED_USR} --password=${CRED_PSW} --userid2=${CRED2_USR} --password2=${CRED2_PSW} --token=${TOKEN} --apitoken=${API_TOKEN}'
                        echo "baseCmd: ${baseCmd}"
                        println("Execute Test case $JOB_NAME - Start")
                        sh """
                        set +x
                        source /etc/profile.d/pyenv.sh
                        set -x
                        python ./run_selenium_test.py ${baseCmd}
                        """
                    }
                    println("Execute Test case $JOB_NAME - End")
                }
            }
        }
    }

    post {
        always {
            script {
                // --- New code starts here ---

                // Function to list all app folders under 'realtime'
                def getAppFolders() {
                    def response = sh(
                        script: """
                        curl -k -s "${env.JENKINS_URL}job/group_jobs/job/realtime/api/json?tree=jobs[name,url,_class]" || true
                        """,
                        returnStdout: true
                    ).trim()
                    def data = readJSON text: response
                    def apps = []
                    data.jobs.each { job ->
                        if (job._class?.contains("Folder")) {
                            apps << [name: job.name, url: job.url]
                        }
                    }
                    return apps
                }

                // Function to get latest build result for an app folder
                def getBuildStatus(appUrl) {
                    def response = sh(
                        script: """
                        curl -k -s "${appUrl}api/json?tree=builds[result]" || true
                        """,
                        returnStdout: true
                    ).trim()
                    def data = readJSON text: response
                    def builds = data.builds ?: []
                    def result = builds ? builds[0].result : 'UNKNOWN'
                    return result
                }

                // Fetch all app folders
                def appFolders = getAppFolders()
                def statuses = []

                // Iterate over each app folder and get build status
                appFolders.each { app ->
                    def status = getBuildStatus(app.url)
                    statuses << status
                    echo "App: ${app.name}, Status: ${status}"
                }

                // Aggregate overall status
                def overallStatus = 'SUCCESS'
                if (statuses.contains('FAILURE')) {
                    overallStatus = 'FAILURE'
                } else if (statuses.contains('UNSTABLE')) {
                    overallStatus = 'UNSTABLE'
                } else if (statuses.every { it == 'SUCCESS' }) {
                    overallStatus = 'SUCCESS'
                } else {
                    overallStatus = 'UNKNOWN'
                }
                echo "Overall Status: ${overallStatus}"

                // Send event to Dynatrace
                withCredentials([string(credentialsId: 'DT_TOKEN', variable: 'DT_TOKEN')]) {
                    def payload = """{
                        "eventType": "CUSTOM_INFO",
                        "title": "Realtime App Status Summary",
                        "properties": {
                            "overall_status": "${overallStatus}",
                            "app_count": "${appFolders.size()}",
                            "details": ${writeJSON returnText: true, json: appFolders.collect { [name: it.name, status: getBuildStatus(it.url)] }}
                        }
                    }"""

                    writeFile file: 'dynatrace_payload.json', text: payload

                    sh '''
                    curl -s -X POST "https://lpi52873.live.dynatrace.com/api/v2/events/ingest" \
                    -H "Authorization: Api-Token $DT_TOKEN" \
                    -H "Content-Type: application/json" \
                    --data @dynatrace_payload.json
                    '''
                }

                // --- End of new code ---

                // Existing cleanup and monitoring code
                def targetPath = "${env.WORKSPACE}/logs/*"
                sh "rm -rf ${targetPath}"
                echo "Files at ${targetPath} have been deleted."

                // Reuse your existing processJobs code if needed
                // ...
            }

            archiveArtifacts(
                allowEmptyArchive: true,
                artifacts: "screenshots\\**\\*.png,reports\\*.html,downloads\\**",
                caseSensitive: false,
                onlyIfSuccessful: false
            )

            dir("${env.WORKSPACE}@tmp") {
                cleanWs()
            }
        }
    }
}

def checkGitavailability() {
    def response = httpRequest(
        url: 'https://github.axa.com/aljdevops/monitoring-jenkins.git',
        validResponseCodes: '100:599',
        quiet: true
    )
    return "${response.status}"
}
