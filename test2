Import-Module CredentialManager

param(
    [string]$VpnName = "AXA_JP VPN",
    [string]$VpnHost = "AXA-JP.WEVPN.AXA.COM",
    [string]$InternetTestHost = "googlea.com",
    [string]$InternalTestHost = "confluence.axa.com",
    [string]$InternalDnsHost = "confluence.axa.com",
    [int]$WaitSeconds = 30,
    [string]$LogDir = "C:\jenkins\vpn-monitor\logs",
    [string]$DynatraceTenantUrl = "https://lpi52873.apps.dynatrace.com"
)

if ([string]::IsNullOrWhiteSpace($LogDir)) {
    $LogDir = "C:\jenkins\vpn-monitor\logs"
}

if (!(Test-Path $LogDir)) {
    New-Item -ItemType Directory -Path $LogDir -Force | Out-Null
}

$timestamp = Get-Date -Format "yyyyMMdd-HHmmss"
$logFile = Join-Path $LogDir "vpn-healthcheck-$timestamp.log"

$ScriptStatus = "SUCCESS"
$FailureReason = ""
$TestSSID = "VPN-Test2"
$BackupSSID = "CoreConnect"

function Get-CurrentSSID {
    $ssid = netsh wlan show interfaces |
        Select-String "^\s*SSID\s*:"

    if ($ssid) {
        return ($ssid -split ":")[1].Trim()
    }

    return ""
}

function Connect-Wifi {
    param([string]$SSID)

    Write-Log "Connecting to WiFi: $SSID"

    netsh wlan disconnect | Out-Null
    Start-Sleep 5

    netsh wlan connect name="$SSID" | Out-Null
    Start-Sleep 20
}




function Write-Log {
    param([string]$Message)

    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "$time | $Message"

    Write-Host $line
    Add-Content -Path $logFile -Value $line -Encoding UTF8
}

function Send-LogToDynatrace {
    try {
        $credential = Get-StoredCredential -Target "DynatraceLogIngest"

        if ($null -eq $credential) {
            Write-Log "Dynatrace upload skipped: Credential DynatraceLogIngest not found."
            return
        }

        $BSTR = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($credential.Password)
        $token = [System.Runtime.InteropServices.Marshal]::PtrToStringUni($BSTR)

        $logContent = Get-Content $logFile -Raw

        $payload = @(
            @{
                content = $logContent
                source = "vpn-healthcheck"
                vpn_name = $VpnName
                vpn_host = $VpnHost
                status = $ScriptStatus
                failure_reason = $FailureReason
                host = $env:COMPUTERNAME
                environment = "POC"
                log_file = $logFile
            }
        ) | ConvertTo-Json -Depth 5

        $headers = @{
            Authorization = "Api-Token $token"
            "Content-Type" = "application/json"
        }

        Invoke-RestMethod `
            -Uri "$DynatraceTenantUrl/api/v2/logs/ingest" `
            -Method Post `
            -Headers $headers `
            -Body $payload

        Write-Log "Dynatrace log upload completed. Status: $ScriptStatus"
    }
    catch {
        Write-Log "Dynatrace log upload failed: $($_.Exception.Message)"
    }
}

function Send-DynatraceMetric {
    param(
        [int]$Value,
        [string]$Result
    )

    try {
        $credential = Get-StoredCredential -Target "DynatraceLogIngest"

        if ($null -eq $credential) {
            Write-Log "Dynatrace metric skipped: Credential DynatraceLogIngest not found."
            return
        }

        $BSTR = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($credential.Password)
        $token = [System.Runtime.InteropServices.Marshal]::PtrToStringUni($BSTR)

        $metricLine = "custom.vpn.healthcheck,status=$Result,vpn=$VpnName,host=$env:COMPUTERNAME $Value"

        $headers = @{
            Authorization = "Api-Token $token"
            "Content-Type" = "text/plain"
        }

        Invoke-RestMethod `
            -Uri "$DynatraceTenantUrl/api/v2/metrics/ingest" `
            -Method Post `
            -Headers $headers `
            -Body $metricLine

        Write-Log "Dynatrace metric uploaded: $metricLine"
    }
    catch {
        Write-Log "Dynatrace metric upload failed: $($_.Exception.Message)"
    }
}

function Fail-Step {
    param([string]$Message)
    $global:ScriptStatus = "FAILED"
    $global:FailureReason = $Message
    Write-Log "FAILED: $Message"
    Write-Log "Switching to CoreConnect..."
    Connect-Wifi $BackupSSID
    $currentSSID = Get-CurrentSSID
    if ($currentSSID -eq $BackupSSID) {
        Write-Log "Connected to CoreConnect successfully."
    }
    else {
        Write-Log "Failed to connect to CoreConnect."
    }

    Send-LogToDynatrace
    Send-DynatraceMetric -Value 0 -Result "FAILED"
    exit 1
}


function Test-Step {
    param(
        [string]$Name,
        [scriptblock]$Command
    )

    Write-Log "START: $Name"

    try {
        & $Command

        if ($LASTEXITCODE -ne $null -and $LASTEXITCODE -ne 0) {
            Fail-Step "$Name failed with exit code $LASTEXITCODE"
        }

        Write-Log "PASS: $Name"
    }
    catch {
        Fail-Step "$Name failed. Error: $($_.Exception.Message)"
    }
}

function Get-VpnStatus {
    $vpn = Get-VpnConnection -Name $VpnName -ErrorAction Stop
    return $vpn.ConnectionStatus
}

function Connect-Vpn {
    Write-Log "Connecting VPN: $VpnName"

    $vpnResult = rasdial "$VpnName"

    foreach ($line in $vpnResult) {
        Write-Log $line
    }

    Start-Sleep -Seconds 10

    $status = Get-VpnStatus

    if ($status -ne "Connected") {
        Fail-Step "VPN connection failed. Current status: $status"
    }

    Write-Log "VPN connected successfully."
}

function Disconnect-Vpn {
    Write-Log "Disconnecting VPN: $VpnName"

    $vpnResult = rasdial "$VpnName" /disconnect

    foreach ($line in $vpnResult) {
        Write-Log $line
    }

    Start-Sleep -Seconds 10

    $status = Get-VpnStatus

    if ($status -ne "Disconnected") {
        Fail-Step "VPN disconnect failed. Current status: $status"
    }

    Write-Log "VPN disconnected successfully."
}

function Send-ReconnectMetric {
    param([double]$ReconnectSeconds)

    try {
        $credential = Get-StoredCredential -Target "DynatraceLogIngest"

        $BSTR = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($credential.Password)
        $token = [System.Runtime.InteropServices.Marshal]::PtrToStringUni($BSTR)

        $metricLine = "custom.vpn.reconnect.duration,vpn=$VpnName,host=$env:COMPUTERNAME $ReconnectSeconds"

        $headers = @{
            Authorization = "Api-Token $token"
            "Content-Type" = "text/plain"
        }

        Invoke-RestMethod `
            -Uri "$DynatraceTenantUrl/api/v2/metrics/ingest" `
            -Method Post `
            -Headers $headers `
            -Body $metricLine

        Write-Log "Reconnect duration metric uploaded."
    }
    catch {
        Write-Log "Reconnect duration metric upload failed: $($_.Exception.Message)"
    }
}

function Invoke-WithRetry {
    param(
        [scriptblock]$Command,
        [string]$StepName,
        [int]$MaxAttempts = 2,
        [int]$DelaySeconds = 30
    )

    for ($attempt = 1; $attempt -le $MaxAttempts; $attempt++) {
        try {
            & $Command
            return
        }
        catch {
            Write-Log "$StepName failed on attempt $attempt"

            if ($attempt -lt $MaxAttempts) {
                Start-Sleep -Seconds $DelaySeconds
            }
            else {
                throw
            }
        }
    }
}



Write-Log "===== VPN HEALTH CHECK STARTED ====="
Write-Log "VPN Name : $VpnName"
Write-Log "VPN Host : $VpnHost"
Write-Log "Internet Test Host : $InternetTestHost"
Write-Log "Internal Test Host : $InternalTestHost"
Write-Log "Internal DNS Host : $InternalDnsHost"
Write-Log "Wait Seconds : $WaitSeconds"
Write-Log "Log File : $logFile"

$currentSSID = Get-CurrentSSID
if ($currentSSID -ne $TestSSID) {
    Connect-Wifi $TestSSID
    Start-Sleep 20
    $currentSSID = Get-CurrentSSID
    if ($currentSSID -ne $TestSSID) {
        Write-Log "Retrying $TestSSID WiFi..."
        Connect-Wifi $TestSSID
        Start-Sleep 20
        $currentSSID = Get-CurrentSSID
        if ($currentSSID -ne $TestSSID) {
            Fail-Step "Unable to connect to $TestSSID WiFi."
        }
    }
}



#  Internet connectivity
Test-Step "Internet connectivity check to $InternetTestHost" {
    $result = Test-NetConnection $InternetTestHost -Port 443
    if ($result.TcpTestSucceeded -ne $true) {
        throw "Internet connectivity failed for $InternetTestHost:443"
    }
}

# DNS resolution
Test-Step "DNS resolution check for VPN hostname $VpnHost" {
    Resolve-DnsName $VpnHost -ErrorAction Stop | Out-Null
}

# VPN gateway reachability
Test-Step "VPN gateway reachability check to $VpnHost" {
    $result = Test-NetConnection $VpnHost -Port 443
    if ($result.TcpTestSucceeded -ne $true) {
        Write-Log "WARNING: VPN gateway port 443 not reachable by raw TCP test. Continuing because VPN client may still connect."
    }
}

# VPN connect
Test-Step "VPN connect" {
    Connect-Vpn
}

# Authentication validation
Test-Step "Authentication validation" {
    $status = Get-VpnStatus
    if ($status -ne "Connected") {
        throw "Authentication/session not connected. Status: $status"
    }
}


# Session status validation
Test-Step "Session status validation" {
    $status = Get-VpnStatus
    Write-Log "VPN session status: $status"

    if ($status -ne "Connected") {
        throw "VPN session status is not Connected"
    }
}

# Internal application access
if ($InternalTestHost -ne "REPLACE_INTERNAL_HOST_OR_IP") {
    Test-Step "Internal application access validation to $InternalTestHost" {
        $result = Test-NetConnection $InternalTestHost -Port 443
        if ($result.TcpTestSucceeded -ne $true) {
            throw "Internal application access failed for $InternalTestHost:443"
        }
    }
}
else {
    Write-Log "SKIPPED: Internal application access. Internal host not configured."
}

# Internal DNS validation
if ($InternalDnsHost -ne "REPLACE_INTERNAL_HOST_OR_IP") {
    Test-Step "Internal DNS validation for $InternalDnsHost" {
        Resolve-DnsName $InternalDnsHost -ErrorAction Stop | Out-Null
    }
}
else {
    Write-Log "SKIPPED: Internal DNS validation. Internal DNS host not configured."
}

# Wait/session persistence
Write-Log "Waiting for $WaitSeconds seconds to simulate real user session..."
Start-Sleep -Seconds $WaitSeconds

Test-Step "Session persistence validation" {
    $status = Get-VpnStatus

    if ($status -ne "Connected") {
        throw "VPN session dropped during wait period. Status: $status"
    }

    Write-Log "VPN remained connected during wait period."
}

#  VPN disconnect
Test-Step "VPN disconnect" {
    Disconnect-Vpn
}

Test-Step "Internal access should fail after disconnect" {
    $result = Test-NetConnection $InternalTestHost -Port 443

    if ($result.TcpTestSucceeded -eq $true) {
        throw "Internal resource still reachable after disconnect"
    }
}


# VPN reconnect
$ReconnectStart = Get-Date
Test-Step "VPN reconnect" {
    Connect-Vpn
}
$ReconnectEnd = Get-Date
$ReconnectSeconds = ($ReconnectEnd - $ReconnectStart).TotalSeconds

Write-Log "VPN Reconnect Duration: $ReconnectSeconds seconds"


# Reconnect validation
Test-Step "Reconnect validation" {
    $status = Get-VpnStatus

    if ($status -ne "Connected") {
        throw "Reconnect validation failed. Status: $status"
    }

    Write-Log "VPN reconnect validation successful."
}

Test-Step "Internal access validation after reconnect" {
    $result = Test-NetConnection $InternalTestHost -Port 443

    if ($result.TcpTestSucceeded -ne $true) {
        throw "Internal access failed after reconnect"
    }
}

Write-Log "Waiting 30 seconds after reconnect..."
Start-Sleep -Seconds 30

Test-Step "VPN stability validation after reconnect" {
    $status = Get-VpnStatus

    if ($status -ne "Connected") {
        throw "VPN unstable after reconnect"
    }
}


# Log capture
Write-Log "Log captured at: $logFile"

# Dynatrace log upload
Send-LogToDynatrace

# Alert trigger validation
Send-DynatraceMetric -Value 1 -Result "SUCCESS"
Send-ReconnectMetric -ReconnectSeconds $ReconnectSeconds
Write-Log "Alert trigger validation: Dynatrace alert should be based on status=FAILED or custom.vpn.healthcheck status=FAILED."
Write-Log "===== VPN HEALTH CHECK COMPLETED SUCCESSFULLY ====="

exit 0
