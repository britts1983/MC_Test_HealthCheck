}

function Invoke-WithRetry {
    param(
        [scriptblock]$Command,
        [string]$StepName,
        [int]$MaxAttempts = 2,
        [int]$DelaySeconds = 30
    )
    for ($attempt = 1; $attempt -le $MaxAttempts; $attempt++) {
        try {
            & $Command
            return
        }
        catch {
            Write-Log "$StepName failed on attempt $attempt"
            if ($attempt -lt $MaxAttempts) {
                Write-Log "Retrying $StepName after $DelaySeconds seconds..."
                Start-Sleep -Seconds $DelaySeconds
            }
            else {
                throw
            }
        }
    }
}


function Send-DynatraceLog {
    try {
        $tokenFile = "C:\Users\he.vpn.ose\Documents\VpnTest\temp\dynatrace.token"
	if (!(Test-Path $tokenFile)) {
   	 Write-Log "Dynatrace token file not found."
  	 return
	}

	$token = Get-Content $tokenFile -Raw
	$token = $token.Trim()
	$logContent = Get-Content $logFile -Raw
        $result = "SUCCESS"
        $logLevel = "INFO"

        if ($Global:ScriptFailed -eq $true) {
            $result = "ERROR"
            $logLevel = "SEVERE"
        }

        Write-Log "Uploading to Dynatrace"
        Write-Log "Payload result: $result"
        Write-Log "Failed step: $Global:FailedStep"
        $payload = @(
            @{
                content     = $logContent
                source      = "vpn-healthcheck"
                vpn_name    = $VpnName
                vpn_host    = $VpnHost
                result      = $result
                Error_details = $Global:FailedStep
                loglevel    = $logLevel
                host        = $env:COMPUTERNAME
                environment = "POC"
            }
        ) | ConvertTo-Json -Depth 5

        $headers = @{
            Authorization  = "Api-Token $token"
            "Content-Type" = "application/json"
        }

        Invoke-RestMethod `
            -Uri "https://lpi52873.live.dynatrace.com/api/v2/logs/ingest" `
            -Method Post `
            -Headers $headers `
            -Body $payload

        Write-Log "Dynatrace log upload successful."
    }
    catch {
        Write-Log "Dynatrace upload failed"
        Write-Log $_.Exception.Message

        if ($_.ErrorDetails.Message) {
            Write-Log $_.ErrorDetails.Message
        }
    }
}

