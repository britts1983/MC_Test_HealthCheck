import groovy.json.JsonOutput

pipeline {
    agent {
            label "built-in"
    }
    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES') // Timeout for the entire pipeline
        sendSplunkConsoleLog()
        disableConcurrentBuilds()
    }
    stages {
        stage('checkout') {
            options {
                timeout(time: 5, unit: 'MINUTES') // Timeout for this specific stage
                }
            steps {
                script {
                    if (checkGitavailability() == '200') {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: '*/main']],
                            userRemoteConfigs: [
                                [url: 'https://github.axa.com/aljdevops/monitoring-jenkins.git',
                                 credentialsId: 'ALJ_OPS_GITHUB_MACHINE_USER']
                            ]
                        ])
                    }
                }
            }
        }
        stage('Build') {
            options {
                timeout(time: 20, unit: 'MINUTES') // Timeout for this specific stage
                }
            steps {
                script {
                    LinkedHashMap resultMap = [:]
                    yamlData = readYaml file:"${WORKSPACE}/${JOB_NAME}.yml"
                    report = yamlData.report
                    parastage = yamlData.jobgroups.collectEntries{
                        ["Excute Application Check : ${it.name}":
                            script{
                                return {
                                    //Store result per nodes
                                    LinkedHashMap jobRetMap = [:]
                                    int retryCnt = 0
                                    while (retryCnt <= 1) {
                                        def ret = build job : it.projectName,
                                            wait : true,
                                            propagate : false
                                        echo "${it.name} - ${NODE_NAME} - ${ret.getResult()}"
                                        jobRetMap.put("${NODE_NAME}", ret)
                                        //Escape rooping when job is success
                                        if (ret.getResult() == "SUCCESS") {
                                            break
                                        }
                                        //Terminate after 2 retry
                                        if (retryCnt >= 1 ) {
                                            break
                                        }
                                        retryCnt = retryCnt + 1
                                    }
                                    resultMap.put(it.name,jobRetMap)
                                }
                            }
                        ]
                    }
                    parallel parastage

                    stage ("Send Email"){
                        boolean overallResult = true
                        String mailbody = '<br>'
                        resultMap.each {
                            boolean jobRresult = false
                            String jobstr = ""
                            it.value.each {
                                if (it.value.getResult() == "SUCCESS") {
                                    jobRresult = true
                                }
                                Date d = new Date(it.value.getStartTimeInMillis())
                                jobstr = jobstr + " - ${it.value.getResult()}, Node:${it.key}, (${it.value.getFullProjectName()}#${it.value.getId()}, ${d}, ${it.value.getDurationString()}) <BR>\n"
                            }
                            if (jobRresult) {
                                mailbody = mailbody + "<strong><font color='blue'>OK</font> ${it.key} </strong><BR>\n"
                            } else {
                                currentBuild.result = 'UNSTABLE'
                                overallResult = false
                                mailbody = mailbody + "<strong><font color='red'>NG</font> ${it.key} </strong><BR>\n"
                            }
                            mailbody = mailbody + jobstr
                        }
                        echo mailbody
                        if (overallResult) {
                            if (!report.unstableOnly || currentBuild.getPreviousBuild().result == "UNSTABLE") {
                                echo 'Send success mail'
                                mail subject : "[OK] ${report.subject}", 
                                body : mailbody + "<BR>Build URL: ${env.BUILD_URL}console",
                                mimeType : "text/html",
                                to : report.mailTo, from: '',
                                replyTo: ''
                            }
                        } else {
                            if (currentBuild.getPreviousBuild().result == "UNSTABLE") {
                                echo "Continuously unstable hence Jenkins doesn't send mail again"
                            } else {
                            echo 'Send unstable mail'
                            mail subject : "[NG] ${report.subject}",
                            body : mailbody + "<BR>Build URL: ${env.BUILD_URL}console",
                            mimeType : "text/html",
                            to : report.mailTo, from: '',
                            replyTo: ''
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        unstable {
            script {
                prev_result = currentBuild.getPreviousBuild().result
                if (prev_result == "UNSTABLE") {
                    echo "Continuously failed hence Jenkins doesn't trigger PagerDuty"
                } else {
                    if (params.pd_integration_key!='' && params.pd_integration_key?.trim() && params.pd_integration_key!=null) {
                        withCredentials([string(credentialsId: params.pd_integration_key, variable: 'pd_integration_key')]){
                            sendPagerDuty()
                        }
                    }
                    if ("${JOB_NAME}".contains("group-jobs/realtime")) {
                        build job: 'Send Notification to Datalake', parameters: [
                        string(name: 'NotificationMessages', value: '現在チェックNGの原因を調査中です。ITチームからの続報をお待ちください。/ IT teams are currently investigating the cause of the NG state for these applications. Please wait for further updates from IT.'),
                        string(name: 'JobName', value: "${JOB_BASE_NAME}")  
                        ]
                    }
                }
            }
        }
        always {
            dir("${env.WORKSPACE}@tmp") {
                cleanWs()
            }
            script {
                def currentTimestamp = java.time.LocalDateTime.now()
                def data = [
                    "event_tag":"build_report",
                    "metadata":[""],
                    "job_name": "${JOB_NAME}",
                    "testsuite":[""],
                    "build_number":"${BUILD_NUMBER}",
                    "page_num":1,
                    "job_result": currentBuild.result,
                    "user":"(timer)",
                    "build_url":"${BUILD_URL}",
                    "endTime": "${currentTimestamp}"
                ]
                def jsonString = JsonOutput.toJson(data)
                echo "Generated JSON: ${jsonString}"
                writeFile file: "jenkins_result.json", text: jsonString
                
                def now = new Date()
                def time = now.format("HH-mm-ss")
                def day = now.format("dd")    // e.g. "08" for the 8th
                def month = now.format("MM")  // e.g. "10" for October
                def year = now.format("YYYY")
                
                if ("${JOB_NAME}".contains("group-jobs/realtime")) {
                    sh """
                    aws s3 cp jenkins_result.json s3://axa-li-jp-jenkins-results-prod/jenkins/${JOB_BASE_NAME}/${year}/${month}/${day}/${time}_jenkins_result.json
                    """
                }

            }
        }
    }
    
}

def sendPagerDuty() {
    def response = httpRequest acceptType: 'APPLICATION_JSON', contentType: 'APPLICATION_JSON',
        httpMode: 'POST', quiet: false,
        url: 'https://events.pagerduty.com/v2/enqueue',
        httpProxy:'http://10.144.64.140:9090',
        ignoreSslErrors: true,
        requestBody: """{
            "payload": {
                "summary":"Application Check Failed for ${JOB_NAME}",
                "severity":"critical",
                "source":"Jenkins MC Check",
                "custom_details":{
                    "Jenkins URL": "${BUILD_URL}"
                    }
                },
            "routing_key": "${pd_integration_key}",
            "event_action":"trigger"
        }"""
    echo "Response: ${response.content}"
}

def checkGitavailability() {
    def response = httpRequest(
        url: 'https://github.axa.com/aljdevops/monitoring-jenkins.git',
        quiet: true,
        validResponseCodes : "100:599")
        echo "${response.status}"
        return "${response.status}"
}
