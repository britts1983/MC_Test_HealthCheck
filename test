import jenkins.model.*
import hudson.model.*
import hudson.model.Job
import com.cloudbees.hudson.plugins.folder.Folder
import com.cloudbees.groovy.cps.NonCPS
import groovy.json.JsonOutput

def realtimeSummary = []

pipeline {

    agent {
        label "built-in"
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
        timeout(time: 30,unit: 'MINUTES' )
        disableConcurrentBuilds()
    }

    stages {

        stage("checkout") {
            options {
                timeout( time: 5,unit: 'MINUTES')
            }

            steps {

                script {
                    if (checkGitavailability() == '20application0') {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[
                                name: '*/main'
                            ]],
                            userRemoteConfigs: [[
                                url: 'https://github.axa.com/aljdevops/monitoring-jenkins.git',
                                credentialsId: 'ALJ_OPS_GITHUB_MACHINE_USER'
                            ]]
                        ])
                    }
                }
            }
        }

        stage('Realtime Monitoring') {

            options {
                timeout(time: 20,unit: 'MINUTES')
            }

            steps {

                script {

                    def dynatraceUrl = "https://lpi52873.live.dynatrace.com/api/v2/events/ingest"
                    withCredentials([
                        string( credentialsId: 'DT_TOKEN', variable: 'DT_TOKEN')
                    ]) {
                        withEnv([
                            "DYNATRACE_URL=${dynatraceUrl}"
                        ]) {
                            echo "STARTING REALTIME MONITORING"
                            def realtimeRows = getRealtimeRows()
                            echo "TOTAL REALTIME JOBS : ${realtimeRows.size()}"
                            for (
                                int i = 0;i < realtimeRows.size(); i++
                            ) {

                                try {

                                    def row = realtimeRows[i]
                                    realtimeSummary.add("${row.job_name} : ${row.job_status}")
                                    echo "APPLICATION : ${row.application}"
                                    echo "JOB : ${row.job_name}"
                                    echo "RESULT : ${row.job_status}"
                                    def overallStatus = row.job_status == "SUCCESS" ? "OK" : "NG"
                                    def payload = [

                                        eventType: "CUSTOM_INFO",
                                        title: "REALTIME APPLICATION STATUS",
                                        properties: [
                                            application: row.application,
                                            overall_status: overallStatus,
                                            job_name: row.job_name,
                                            job_status: row.job_status,
                                            job_duration : row.job_duration.toString(),
                                            checked: row.checked,
                                            type: "REALTIME"
                                        ]
                                    ]

                                    writeFile(
                                        file: "realtime_payload.json",
                                        text: JsonOutput.toJson(payload)
                                    )

                                    sh '''
                                        curl --fail -X POST "$DYNATRACE_URL" \
                                        -H "Authorization: Api-Token $DT_TOKEN" \
                                        -H "Content-Type: application/json" \
                                        --data @realtime_payload.json
                                        '''

                                } catch (Exception ex) {
                                    echo "REALTIME PUSH ERROR : ${ex}"
                                }
                            }

                                                   
                            echo "STARTING APPLICATION HEALTH MONITORING"
                            def applicationRows =  getApplicationHealthRows()
                            echo "TOTAL APPLICATIONS : ${applicationRows.size()}"
                            for (
                                int i = 0; i < applicationRows.size();  i++) {
                                try {

                                    def row = applicationRows[i]
                                    echo "APPLICATION : ${row.application}"
                                    echo "OVERALL STATUS : ${row.overall_status}"
                                    def payload = [
                                        eventType: "CUSTOM_INFO",
                                        title: "APPLICATION HEALTH STATUS",

                                        properties: [
                                            application: row.application,
                                            overall_status: row.overall_status,
                                            job_details: row.job_details,
                                            jobs:row.jobs.join(" | "),
                                            job_duration : row.job_duration.toString(),
                                            checked:  row.checked,
                                            type: "APPLICATION"
                                        ]
                                    ]

                                    writeFile(
                                        file: "application_payload.json",
                                        text:JsonOutput.toJson(payload)
                                    )

                                    sh '''
                                        curl --fail -X POST "$DYNATRACE_URL" \
                                        -H "Authorization: Api-Token $DT_TOKEN" \
                                        -H "Content-Type: application/json" \
                                        --data @application_payload.json
                                        '''
                                } catch (Exception ex) {
                                    echo "APPLICATION PUSH ERROR : ${ex}"
                                }
                            }

                            echo "REALTIME JOB SUMMARY"
                           
                            for (
                                int r = 0;
                                r < realtimeSummary.size();
                                r++
                            ) {
                                echo realtimeSummary[r]
                            }

                            echo "APPLICATION HEALTH SUMMARY"           
                            for (
                                int a = 0;
                                a < applicationRows.size();
                                a++
                            ) {

                                def appRow = applicationRows[a]
                                echo "${appRow.application} : ${appRow.overall_status}"
                                echo "APP Duaration : ${appRow.job_duration}"
                                if (appRow.jobs != null) {
                                    for (
                                        int j = 0; j < appRow.jobs.size(); j++
                                    ) {
                                        echo "CHILD JOB : ${appRow.jobs[j]}"
                                    }
                                }
                            }

                            echo "DYNATRACE UPDATE COMPLETED"
                        }
                    }
                }
            }
        }
    }

    post {

        always {
            script {
                echo "PIPELINE FINISHED"
                try {
                    cleanWs()
                    echo "WORKSPACE CLEANUP COMPLETED"
                } catch (error) {
                    echo "CLEANUP FAILED : ${error}"
                }
            }
        }
    }
}
@NonCPS
def getRealtimeRows() {

    def rows = []
    def realtimeFolder = Jenkins.instance.getItemByFullName(  "group-jobs/realtime" )
    if (realtimeFolder == null) {
        return rows
    }
    def realtimeFolders = new ArrayList( realtimeFolder.getItems() )
    for (
        int i = 0;  i < realtimeFolders.size(); i++
    ) {
        def appFolder = realtimeFolders[i]
        if (!(appFolder instanceof Folder)) {
            continue
        }
        def appName = appFolder.getName().toString()
        if (
            appName ==  "001-seed-applications"
        ) {
            continue
        }
        def jobs = new ArrayList( appFolder.getItems())
        for (
            int j = 0;j < jobs.size();j++) {
            def job =  jobs[j]
            if (!(job instanceof Job)) {
                continue
            }
            def finalResult = "SUCCESS"
            def duration = 0

            try {
                def build = job.getLastCompletedBuild()
                duration = build ? build.getDuration() / 1000 : 0
                if (
                    build == null ||
                    build.getResult() == null ||
                    build.getResult().toString() != "SUCCESS"
                ) {
                    finalResult = "UNSTABLE"
                }
            } catch (Exception ex) {
                finalResult = "UNSTABLE"
            }

            rows.add([
                application:  appName,
                job_name:  job.getFullName().toString(),
                job_status: finalResult,
                job_duration: duration,
                checked: new Date().format( "yyyy-MM-dd HH:mm:ss").toString()
            ])
        }
    }

    return rows
}

@NonCPS
def getApplicationHealthRows() {

    def rows = []
    def applicationFolder =Jenkins.instance.getItemByFullName("applications")
    if (applicationFolder == null) {
        return rows
    }
    def applicationResults = [:] 
    scanApplicationFolder( 
        applicationFolder,
        applicationResults)
    def appNames = new ArrayList( applicationResults.keySet())
    for (
        int i = 0; i < appNames.size();  i++) {
        def appName = appNames[i].toString()
        echo "ROW Duration: ${applicationResults[appName]["duration"]}"
       rows.add([
            application: appName,
            overall_status: applicationResults[appName]["status"],
            job_details: applicationResults[appName]["jobs"].join("\n "),
            jobs: applicationResults[appName]["jobs"],
            job_duration: applicationResults[appName]["duration"],
            checked:
            new Date().format(
                "yyyy-MM-dd HH:mm:ss"
            ).toString()
        ])

    }

    return rows
}

@NonCPS
def scanApplicationFolder(
    def folder,
    def applicationResults
