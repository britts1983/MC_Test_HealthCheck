import jenkins.model.*
import hudson.model.*
import hudson.model.Job
import com.cloudbees.hudson.plugins.folder.Folder
import com.cloudbees.groovy.cps.NonCPS
import groovy.json.JsonOutput

pipeline {

    agent {
        label "built-in"
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
        timeout(time: 30,unit: 'MINUTES' )
        disableConcurrentBuilds()
    }

    stages {

        stage("checkout") {
            options {
                timeout( time: 5,unit: 'MINUTES')
            }

            steps {

                script {
                    if (checkGitavailability() == '20application0') {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[
                                name: '*/main'
                            ]],
                            userRemoteConfigs: [[
                                url: 'https://github.axa.com/aljdevops/monitoring-jenkins.git',
                                credentialsId: 'ALJ_OPS_GITHUB_MACHINE_USER'
                            ]]
                        ])
                    }
                }
            }
        }

        stage('Realtime Monitoring') {

            options {
                timeout(time: 20,unit: 'MINUTES')
            }

            steps {

                script {

                    def dynatraceUrl = "https://lpi52873.live.dynatrace.com/api/v2/events/ingest"
                    withCredentials([
                        string( credentialsId: 'DT_TOKEN', variable: 'DT_TOKEN')
                    ]) {
                        withEnv([
                            "DYNATRACE_URL=${dynatraceUrl}"
                        ]) {
                            echo "STARTING REALTIME MONITORING"
                            def realtimeRows = getRealtimeRows()
                            echo "TOTAL REALTIME JOBS : ${realtimeRows.size()}"
                            for (
                                int i = 0;i < realtimeRows.size(); i++
                            ) {

                                try {

                                    def row = realtimeRows[i]
                                    realtimeSummary.add("${row.job_name} : ${row.job_status}")
                                    echo "APPLICATION : ${row.application}"
                                    echo "JOB : ${row.job_name}"
                                    echo "RESULT : ${row.job_status}"
                                    def overallStatus = row.job_status == "SUCCESS" ? "OK" : "NG"
                                    def payload = [

                                        eventType: "CUSTOM_INFO",
                                        title: "REALTIME APPLICATION STATUS",
                                        properties: [
                                            application: row.application,
                                            overall_status: overallStatus,
                                            job_name: row.job_name,
                                            job_status: row.job_status,
                                            checked: row.checked,
                                            type: "REALTIME"
                                        ]
                                    ]

                                    writeFile(
                                        file: "realtime_payload.json",
                                        text: JsonOutput.toJson(payload)
                                    )

                                    sh '''
                                        curl --fail -X POST "$DYNATRACE_URL" \
                                        -H "Authorization: Api-Token $DT_TOKEN" \
                                        -H "Content-Type: application/json" \
                                        --data @realtime_payload.json
                                        '''

                                } catch (Exception ex) {
                                    echo "REALTIME PUSH ERROR : ${ex}"
                                }
                            }

                                                   
                            echo "STARTING APPLICATION HEALTH MONITORING"
                            def applicationRows =  getApplicationHealthRows()
                            echo "TOTAL APPLICATIONS : ${applicationRows.size()}"
                            for (
                                int i = 0; i < applicationRows.size();  i++) {
                                try {

                                    def row = applicationRows[i]
                                    echo "APPLICATION : ${row.application}"
                                    echo "OVERALL STATUS : ${row.overall_status}"
                                    def payload = [
                                        eventType: "CUSTOM_INFO",
                                        title: "APPLICATION HEALTH STATUS",

                                        properties: [
                                            application: row.application,
                                            overall_status: row.overall_status,
                                            checked:  row.checked,
                                            type: "APPLICATION"
                                        ]
                                    ]

                                    writeFile(
                                        file: "application_payload.json",
                                        text:JsonOutput.toJson(payload)
                                    )

                                    sh '''
                                        curl --fail -X POST "$DYNATRACE_URL" \
                                        -H "Authorization: Api-Token $DT_TOKEN" \
                                        -H "Content-Type: application/json" \
                                        --data @application_payload.json
                                        '''
                                } catch (Exception ex) {
                                    echo "APPLICATION PUSH ERROR : ${ex}"
                                }
                            }

                            echo "REALTIME JOB SUMMARY"
                           
                            for (
                                int r = 0;
                                r < realtimeSummary.size();
                                r++
                            ) {
                                echo realtimeSummary[r]
                            }

                            echo "APPLICATION HEALTH SUMMARY"           
                            for (
                                int a = 0;
                                a < applicationRows.size();
                                a++
                            ) {

                                def appRow = applicationRows[a]
                                echo "${appRow.application} : ${appRow.overall_status}"
                            }

                            echo "DYNATRACE UPDATE COMPLETED"
                        }
                    }
                }
            }
        }
    }

    post {

        always {
            script {
                echo "PIPELINE FINISHED"
                try {
                    cleanWs()
                    echo "WORKSPACE CLEANUP COMPLETED"
                } catch (error) {
                    echo "CLEANUP FAILED : ${error}"
                }
            }
        }
    }
}


@NonCPS
def getRealtimeRows() {

    def rows = []
    def realtimeFolder = Jenkins.instance.getItemByFullName(  "group-jobs/realtime" )
    if (realtimeFolder == null) {
        return rows
    }
    def realtimeFolders = new ArrayList( realtimeFolder.getItems() )
    for (
        int i = 0;  i < realtimeFolders.size(); i++
    ) {
        def appFolder = realtimeFolders[i]
        if (!(appFolder instanceof Folder)) {
            continue
        }
        def appName = appFolder.getName().toString()
        if (
            appName ==  "001-seed-applications"
        ) {
            continue
        }
        def jobs = new ArrayList( appFolder.getItems())
        for (
            int j = 0;j < jobs.size();j++) {
            def job =  jobs[j]
            if (!(job instanceof Job)) {
                continue
            }
            def finalResult =  "SUCCESS"
            try {
                def build =  job.getLastCompletedBuild()
                if (
                    build == null ||  build.getResult() == null ||  build.getResult().toString() != "SUCCESS"
                ) {
                    finalResult = "UNSTABLE"
                }
            } catch (Exception ex) {
                finalResult =  "UNSTABLE"
            }

            rows.add([
                application:  appName,
                job_name:  job.getFullName().toString(),
                job_status: finalResult,
                checked: new Date().format( "yyyy-MM-dd HH:mm:ss").toString()
            ])
        }
    }

    return rows
}


@NonCPS
def getApplicationHealthRows() {

    def rows = []
    def applicationFolder =Jenkins.instance.getItemByFullName("applications")

    if (applicationFolder == null) {
        return rows
    }

    def applicationResults = [:] 
    scanApplicationFolder( 
        applicationFolder,
        applicationResults)
    def appNames = new ArrayList( applicationResults.keySet())
    for (
        int i = 0; i < appNames.size();  i++) {
        def appName = appNames[i].toString()
       rows.add([
            application: appName,
            overall_status: applicationResults[appName]["status"],
            job_details: applicationResults[appName]["jobs"].join(" | "),
            checked:
            new Date().format(
                "yyyy-MM-dd HH:mm:ss"
            ).toString()
        ])

    }

    return rows
}

@NonCPS
def scanApplicationFolder(
    def folder,
    def applicationResults
) 
{
    def items = new ArrayList( folder.getItems())
    for (
        int i = 0;  i < items.size();  i++)
        {
            def item = items[i]
        if ( item.getName().toString() == "001-seed-applications") {
            continue
        }
        if (item instanceof Folder) {
            scanApplicationFolder( item,applicationResults )
            continue
        }

        if (!(item instanceof Job)) {
            continue
        }

        def fullName = item.getFullName().toString()
        def excludePatterns = [
            "/preprod/",
            "/dev/",
            "/sit/",
            "/uat/",
            "/test/"
        ]

        boolean excluded = false
        for (int e = 0; e < excludePatterns.size(); e++) {
            if (
                fullName.contains( excludePatterns[e])
            ) {
                excluded = true
                break
            }
        }
        if (excluded) {
            continue
        }
        def blockedJobs = [
            "applications/emma/functional-check-next-gen",
            "applications/emma/login-only-functional-check",
            "applications/emma/login-only-functional-check-next-gen",
            "applications/emma/myaxaadmin-login-check",
            "applications/ndhats/functional-check",
            "applications/canweb/manage-functional-check",
            "applications/canweb/password-change",
            "applications/canweb/simple-functional-check",
            "applications/new-biz-data-registration-system",
            "applications/recruitimp",
            "applications/siteminder",
            "applications/webedi-ts",
            "applications/customer-master-data-management",
            "applications/claims-reception-web",
            "applications/cis-plus"
        ]
        boolean blocked = false
        for (int b = 0; b < blockedJobs.size(); b++ )
             {
                if (fullName.contains(blockedJobs[b]) ) {
                    blocked = true
                    break
                }
         }
        if (blocked) {
            continue
        }
        def allowedPatterns = [
            "functional-check",
            "api-check",
            "login",
            "download-file",
            "notification",
            "policy-details",
            "policy-loan",
            "check-address-master",
            "check-bank-master",
            "px-calculator",
            "broker-application",
            "commission",
            "corporate-search",
            "policy-search",
            "registration-inquiry",
            "training-history",
            "sales-score",
            "special-agency",
            "icm-admin",
            "icm-general",
            "weekday-functional-check",
            "owner-functional-check",
            "owner-functional-check-report-creation",
            "sales-functional-check",
            "qit-functional-check",
            "spw-functional-check",
            "external-functional-check",
            "internal-functional-check",
            "webbar-functional-check",
            "name-change-functional-check",
            "address-change-functional-check",
            "proxy-request-functional-check",
            "surrender-functional-check",
            "cloud-functional-check",
            "nttgw-functional-check",
            "nttgw-accessonly-functional-check",
            "customer-list-functional-check",
            "gmo-api-check",
            "www2-api-check",
            "aura-api-check",
            "cashless-premium-collection-management-system",
            "ods-authorization-management-tool"
        ]

        boolean monitorJob = false
        for (
            int p = 0; p < allowedPatterns.size(); p++
        ) {

            if (
                fullName.contains(
                    allowedPatterns[p]
                )
            ) {
                monitorJob = true
                break
            }
}

if (!monitorJob) {
    continue
}
        def parts = fullName.tokenize("/")
        if (parts.size() < 2) {
            continue
        }

        def appName = parts[1].toString()
        if (
            !applicationResults.containsKey(appName)
        ) {
            applicationResults[appName] =[
                status : "OK",
                jobs : []
            ]
        }

        try {

            def build = item.getLastCompletedBuild()
            if (
                build == null ||
                build.getResult() == null ||
                build.getResult().toString() != "SUCCESS"
            ) {
                applicationResults[appName] ["status"] =  "NG"
            }

        } catch (Exception ex) {
            applicationResults[appName] ["status"] =  "NG"
        }
    }
}


def checkGitavailability() {
    def response = httpRequest(
        url:  'https://github.axa.com/aljdevops/monitoring-jenkins.git',
        validResponseCodes: '100:599',
        quiet:  true
    )
    return "${response.status}"
}
