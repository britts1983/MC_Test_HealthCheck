pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/britts1983/MC_Test_HealthCheck.git'
            }
        }

        stage('Setup Python') {
            steps {
                sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install -r requirements.txt
                '''
            }
        }

        stage('Run Test') {
            steps {
                sh '''
                . venv/bin/activate
                mkdir -p artifacts
                python src/run.py --headless
                '''
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts artifacts: 'artifacts/*', allowEmptyArchive: true
            }
        }
    }
}